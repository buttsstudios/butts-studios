{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/((?!shop|games/|work/|assets/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-4H7bNL7wZyBR45Dj9wr05cQOmdNjpUSZUNtbiu5ncX4=' 'sha256-T0Nb2rWAIsiRTXZBM7B45n2Z2kZ5rMs8jg3QuOokF5E=' 'sha256-Y6x8eVszFiaLUwdvnqFLp2YJInsUn8G4uHA5F9Slt4M='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self' https:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/shop",
      "destination": "https://shop-buttsstudios.vercel.app/shop/"
    },
    {
      "source": "/shop/:path*",
      "destination": "https://shop-buttsstudios.vercel.app/shop/:path*"
    },
    {
      "source": "/games/glowgrid",
      "destination": "https://glb-game.vercel.app/"
    },
    {
      "source": "/games/glowgrid/:path*",
      "destination": "https://glb-game.vercel.app/:path*"
    },
    {
      "source": "/games/cards",
      "destination": "https://butts-cards.vercel.app/games/cards"
    },
    {
      "source": "/games/cards/:path*",
      "destination": "https://butts-cards.vercel.app/games/cards/:path*"
    },
    {
      "source": "/games/sliding-numbers",
      "destination": "https://butts-puzzle.vercel.app/games/sliding-numbers"
    },
    {
      "source": "/games/sliding-numbers/:path*",
      "destination": "https://butts-puzzle.vercel.app/games/sliding-numbers/:path*"
    }
  ]
}
