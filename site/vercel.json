{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/shop",
      "destination": "https://shop-buttsstudios.vercel.app/shop/"
    },
    {
      "source": "/shop/:path*",
      "destination": "https://shop-buttsstudios.vercel.app/shop/:path*"
    },
    {
      "source": "/games/glowgrid",
      "destination": "https://glb-game.vercel.app/"
    },
    {
      "source": "/games/glowgrid/:path*",
      "destination": "https://glb-game.vercel.app/:path*"
    },
    {
      "source": "/games/cards",
      "destination": "https://butts-cards.vercel.app/games/cards"
    },
    {
      "source": "/games/cards/:path*",
      "destination": "https://butts-cards.vercel.app/games/cards/:path*"
    },
    {
      "source": "/games/sliding-numbers",
      "destination": "https://butts-puzzle.vercel.app/games/sliding-numbers"
    },
    {
      "source": "/games/sliding-numbers/:path*",
      "destination": "https://butts-puzzle.vercel.app/games/sliding-numbers/:path*"
    }
  ]
}
