{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "glb.buttsstudios.com"
        }
      ],
      "destination": "/games/glowgrid",
      "statusCode": 301
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "glb.buttsstudios.com"
        }
      ],
      "destination": "/games/glowgrid/:path",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "cards.buttsstudios.com"
        }
