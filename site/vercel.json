{ "cleanUrls": false, "trailingSlash": false,
  "headers": [ { "source": "/assets/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ] } ],
  "rewrites": [
    { "source": "/shop", "destination": "https://shop-buttsstudios.vercel.app/shop/" },
    { "source": "/shop/:path*", "destination": "https://shop-buttsstudios.vercel.app/shop/:path*" }
  ] }
