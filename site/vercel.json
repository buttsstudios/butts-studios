{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/shop",
      "destination": "https://shop-buttsstudios.vercel.app/shop/"
    },
    {
      "source": "/shop/:path*",
      "destination": "https://shop-buttsstudios.vercel.app/shop/:path*"
    },
    {
      "source": "/games/glowgrid",
      "destination": "https://glb-game.vercel.app/"
    },
    {
      "source": "/games/glowgrid/:path*",
      "destination": "https://glb-game.vercel.app/:path*"
    },
    {
      "source": "/games/cards",
      "destination": "https://butts-cards.vercel.app/games/cards"
    },
    {
      "source": "/games/cards/:path*",
      "destination": "https://butts-cards.vercel.app/games/cards/:path*"
    },
    {
      "source": "/games/sliding-numbers",
      "destination": "https://butts-puzzle.vercel.app/games/sliding-numbers"
    },
    {
      "source": "/games/sliding-numbers/:path*",
      "destination": "https://butts-puzzle.vercel.app/games/sliding-numbers/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/terms.html",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/refunds.html",
      "destination": "/refunds",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/games.html",
      "destination": "/games",
      "permanent": true
    },
    {
      "source": "/books.html",
      "destination": "/books",
      "permanent": true
    },
    {
      "source": "/how-we-work.html",
      "destination": "/how-we-work",
      "permanent": true
    },
    {
      "source": "/work.html",
      "destination": "/work",
      "permanent": true
    }
  ]
}
